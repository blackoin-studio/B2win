NODE_ENV=development
PORT=5000

# JWT Authentication
JWT_SECRET=your_jwt_secret_here

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini API (Optional - powers gemini-3.8-flash AI features; falls back to built-in analytics engine if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Legacy MongoDB Configuration (only used by scripts/migrate-mongo-to-supabase.js)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/b2win

